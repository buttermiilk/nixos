# i3 config file

for_window [class="^.*"] border pixel 0

# set mod key (Mod1=<Alt>, Mod4=<Super>)
set $mod Mod4

# the 'linux' one is for my Arch installation
# the other one, 'win', is for my Windows installation but placed in here so I can download it later.
exec --no-startup-id feh --bg-center ~/.config/wallpapers/linux.jpg
# picom window compositor
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id fcitx5 -d
exec --no-startup-id blueman-applet
exec --no-startup-id polybar main
exec_always --no-startup-id setxkbmap -option
exec_always --no-startup-id autotiling
exec_always --no-startup-id xborders --border-radius 0 --border-width 3 --border-red 111 --border-green 143 --border-blue 168

# Font for window titles. Polybar selects its own font in config.ini.
font pango:Fantasque Sans Mono Bold 13

# gaps
gaps outer 5
gaps inner 20

# use mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# open a terminal
bindsym $mod+Return exec kitty

# send the terminal to the scratchpad
bindsym $mod+Shift+f move scratchpad

# show the scratchpad terminal
bindsym $mod+minus scratchpad show
bindsym $mod+shift+minus  move workspace current

# kill focused window
bindsym $mod+q kill

# open rofi (a program launcher)
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Tab exec --no-startup-id rofi -show window
bindsym $mod+p exec --no-startup-id ~/.config/rofi/powermenu.sh

# toggle the sleep-inhibiting click loop after the chord has been released
bindsym --release $mod+Mod1+x exec --no-startup-id inhibit-clicker toggle

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# enter fullscreen mode for the focused container
bindsym $mod+Shift+Return fullscreen toggle

# change split orientation
bindsym $mod+e layout toggle split

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Audio controls using pactl
bindsym F5 exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym F6 exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym F7 exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%

# Brightness controls
bindsym F3 exec --no-startup-id brightnessctl set 10%-
bindsym F4 exec --no-startup-id brightnessctl set +10%

# Microphone mute/unmute
bindsym F8 exec --no-startup-id amixer set Capture toggle

# Screenshot
bindsym F12 exec flameshot gui

# split orientation
bindsym $mod+z split h;exec notify-send 'tile horizontally'
bindsym $mod+v split v;exec notify-send 'tile vertically'

# toggle tiling / floating
bindsym $mod+f floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
  # These bindings trigger as soon as you enter the resize mode

  # Pressing left will shrink the window’s width.
  # Pressing right will grow the window’s width.
  # Pressing up will shrink the window’s height.
  # Pressing down will grow the window’s height.
  bindsym j resize shrink width 10 px or 10 ppt
  bindsym k resize grow height 10 px or 10 ppt
  bindsym l resize shrink height 10 px or 10 ppt
  bindsym semicolon resize grow width 10 px or 10 ppt

  # same bindings, but for the arrow keys
  bindsym Left resize shrink width 10 px or 10 ppt
  bindsym Down resize grow height 10 px or 10 ppt
  bindsym Up resize shrink height 10 px or 10 ppt
  bindsym Right resize grow width 10 px or 10 ppt

  # back to normal: Enter or Escape or $mod+r
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Color scheme shared with Polybar
set $background      #1f1f1f
set $background_alt  #373b41
set $foreground      #ffffff
set $primary         #6f8fa8
set $secondary       #536b7e
set $alert           #a54242

# Colors for window borders, background, text, and indicators.
#                       border              background          text                 indicator
client.focused          $primary            $primary            $foreground          $primary
client.focused_inactive $secondary          $secondary          $foreground          $secondary
client.unfocused        $background_alt     $background_alt     $foreground          $background_alt
client.urgent           $alert              $alert              $foreground          $alert
